{
  "name": "simplecrudapi",
  "version": "1.0.0",
  "description": "Simple CRUD API (TS, dev/prod)",
  "type": "module",
  "main": "dist/bundle.js",
  "scripts": {
    "start:dev": "cross-env NODE_ENV=development nodemon --watch src --ext ts,js --exec \"node --loader ts-node/esm ./src/index.ts\"",
    "build": "webpack --mode production",
    "start:prod": "npm run build && node dist/bundle.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "nodemon": "^3.1.10",
    "ts-loader": "^9.5.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "license": "ISC"
}
